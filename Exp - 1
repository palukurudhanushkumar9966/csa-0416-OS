#include <stdio.h>
#include <unistd.h>
#include <stdlib.h>

int main()
{
    pid_t pid;

    pid = fork();

    if (pid < 0)
    {
        perror("fork failed");
        exit(1);
    }
    else if (pid == 0)
    {
        // Child process
        printf("Child Process\n");
        printf("Child Process ID  : %d\n", getpid());
        printf("Parent Process ID : %d\n", getppid());
    }
    else
    {
        // Parent process
        printf("Parent Process\n");
        printf("Parent Process ID : %d\n", getpid());
        printf("Parent's Parent ID: %d\n", getppid());
    }

    return 0;
}
